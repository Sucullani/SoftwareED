# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# PyInstaller
*.manifest
# build.spec is intentionally tracked

# Inno Setup: el instalador generado (installer/EduFEM.iss SI se versiona)
installer/Output/

# TeX Live recortado que embebe el instalador (lo genera tools/build_texlive.py;
# ~50 MB, reproducible desde el script) y la descarga de TinyTeX-0
vendor/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# Project-specific
compile_output*.txt
# Plantilla LaTeX de referencia (ex docs/Example.tex): se conserva en disco como
# ejemplo de estilos tcolorbox, pero no se versiona.
docs/auditorias/historico/plantilla_latex_ejemplo.*

# Temporales de desarrollo / escritura atomica abortada / scratch
*.tmp
*.tmp.*
temp_*

# Artefactos intermedios de render Manim (regenerables desde los .py de escena;
# el .webp final vive versionado en resources/videos/)
tools/**/media/

# User config / runtime
~/.edufem/
*.edufem.bak

# Claude Code harness runtime state (lock efimero de tareas programadas)
.claude/scheduled_tasks.lock
.claude/*.lock

# Libros y papers de referencia de la tesis: material con copyright, no se versiona
tesis/bibliografia/*.pdf
tesis/bibliografia/resaltados/

# Guias de estilo de terceros en tesis/normas/: mismo criterio que los papers.
# Las guias propias (guia_*.tex / .pdf) SI se versionan.
tesis/normas/Tavares*.pdf

# PDF de la bibliografia pedagogica (copyright, repo publico): misma regla que tesis/bibliografia/*.pdf
tesis/bibliografia/**/*.pdf
