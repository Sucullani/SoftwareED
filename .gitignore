# Project-specific
compile_output*.txt
# PDFs de referencias bibliograficas (articulos de pago: NO redistribuir en
# repo publico). El main.pdf de la tesis SI se versiona (no esta aqui).
tesis/bibliografia/*.pdf
Example.pdf
Example.aux
Example.log
Example.out
Example.toc
docs/Example.*

# Temporales de desarrollo / escritura atomica abortada / scratch
*.tmp
*.tmp.*
temp_*

# Artefactos intermedios de render Manim (regenerables desde los .py de escena;
# el .webp final vive versionado en resources/videos/)
tools/**/media/

# User config / runtime
~/.edufem/
*.edufem.bak

# Claude Code harness runtime state (lock efimero de tareas programadas)
.claude/scheduled_tasks.lock
.claude/*.lock
